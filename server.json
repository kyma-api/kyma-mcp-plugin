{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.kymaapi/kyma",
  "title": "Kyma API",
  "description": "Live model catalog with prices and measured uptime, rankings, credits and spend, spend-capped chat.",
  "version": "1.0.2",
  "websiteUrl": "https://kymaapi.com",
  "repository": {
    "url": "https://github.com/kyma-api/kyma-mcp-plugin",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.kymaapi.com/mcp"
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/kyma-api/kyma-mcp-plugin/main/assets/logo-400.png",
      "mimeType": "image/png",
      "sizes": [
        "400x400"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/kyma-api/kyma-mcp-plugin/main/assets/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@kyma-api/mcp-server",
      "version": "1.0.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KYMA_MCP_KEY",
          "description": "Optional Kyma MCP key (km-\u2026) from kymaapi.com/integrations to skip the browser sign-in",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
